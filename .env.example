# ── Jedyna zmienna potrzebna do uruchomienia aplikacji ────────────────────
# Platforma sandbox ustawia ją automatycznie w .env. Nie musisz nic wpisywać.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Opcjonalne: TYLKO przy wdrożeniu statycznym na GitHub Pages ───────────
# Wklej jako jeden JSON obiekt konfiguracji aplikacji webowej z konsoli Firebase.
# Bez tej zmiennej aplikacja działa w trybie demo (lokalny backend).
# W GitHub Actions wystarczy jeden secret o tej samej nazwie.
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","appId":"","messagingSenderId":""}'

# ── Opcjonalne: tylko do pracy z Firebase Emulator Suite ──────────────────
# NEXT_PUBLIC_FIREBASE_EMULATOR=1

# Flagi budowania statycznego ustawia workflow CI, nie trzeba ich podawać lokalnie:
# EXPORT_STATIC=1  NEXT_PUBLIC_BASE_PATH=/nazwa-repo
